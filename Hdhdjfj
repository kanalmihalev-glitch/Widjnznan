end

local function hasKnife()
    if not LocalPlayer.Character then return false end
    local char=LocalPlayer.Character
    local bp=LocalPlayer:FindFirstChild("Backpack")
    return (char:FindFirstChild("Knife") or (bp and bp:FindFirstChild("Knife")))~=nil
end

local function getVictims()
    local list={}
    if not hrp then return list end
    local myPos=hrp.Position
    for _,p in pairs(Players:GetPlayers()) do
        if p==LocalPlayer then continue end
        local char=p.Character
        if not char then continue end
        local hum=char:FindFirstChildOfClass("Humanoid")
        local tHrp=char:FindFirstChild("HumanoidRootPart")
        if not hum or hum.Health<=0 or not tHrp then continue end
        table.insert(list,{HRP=tHrp,Humanoid=hum,Distance=(tHrp.Position-myPos).Magnitude})
    end
    table.sort(list,function(a,b) return a.Distance<b.Distance end)
    return list
end

local function equipKnife()
    if not LocalPlayer.Character then return end
    local char=LocalPlayer.Character
    local bp=LocalPlayer:FindFirstChild("Backpack")
    local knife=char:FindFirstChild("Knife") or (bp and bp:FindFirstChild("Knife"))
    if knife and humanoid and knife.Parent~=char then humanoid:EquipTool(knife) end
end

local function killLoop()
    while killing do
        if not LocalPlayer.Character then task.wait(1) continue end
        refreshHrp()
        if not hrp then task.wait(0.3) continue end
        if not hasKnife() then task.wait(0.5) continue end
        equipKnife()
        local victims=getVictims()
        if #victims==0 then task.wait(0.5) continue end
        local target=victims[1]
        if flyTo(target.HRP.Position+Vector3.new(0,1,0),KILL_SPEED) and target.Humanoid.Health>0 then
            hrp.CFrame=CFrame.new(target.HRP.Position+Vector3.new(0,1,0))
            task.wait(0.05)
            local tool=LocalPlayer.Character:FindFirstChild("Knife")
            if tool and tool:IsA("Tool") then pcall(function() tool:Activate() end) end
            task.wait(0.15)
            if target.Humanoid.Health<=0 then kills=kills+1 end
        end
        task.wait(0.1)
    end
end

local function startKill()
    if killing then return end
    killing=true
    if not farming and not tping then startNoclip() end
    task.spawn(killLoop)
end

local function stopKill()
    killing=false
    if not farming and not tping and not flying then stopNoclip() end
end

local function getRole(player)
    if player==LocalPlayer then return "You",Color3.fromRGB(255,255,255) end
    local char=player.Character
    if not char then return "Innocent",Color3.fromRGB(0,255,0) end
    local hum=char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health<=0 then return "Dead",Color3.fromRGB(120,120,120) end
    local bp=player:FindFirstChild("Backpack")
    if char:FindFirstChild("Knife") or (bp and bp:FindFirstChild("Knife")) then return "Murderer",Color3.fromRGB(255,40,40) end
    if char:FindFirstChild("Gun") or (bp and bp:FindFirstChild("Gun")) or char:FindFirstChild("Revolver") or (bp and bp:FindFirstChild("Revolver")) then return "Sheriff",Color3.fromRGB(40,140,255) end
    return "Innocent",Color3.fromRGB(0,255,0)
end

local function takeCharOwnership(char)
    if not char then return end
    local root=char:FindFirstChild("HumanoidRootPart")
    if root then pcall(function() root:SetNetworkOwner(LocalPlayer) end) end
    for _,p in pairs(char:GetDescendants()) do
        if p:IsA("BasePart") then pcall(function() p:SetNetworkOwner(LocalPlayer) end) end
    end
end

local function doTeleport()
    if not tpTargetPlayer or not tpTargetPlayer.Character then return end
    refreshHrp()
    if not hrp or not hrp.Parent then return end
    local tHrp=tpTargetPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not tHrp then return end
    local mode=TP_MODE_OPTIONS[TP_MODE_INDEX].key
    if mode=="tp_to_player" then
        pcall(function()
            hrp.CFrame=CFrame.new(tHrp.Position+Vector3.new(0,3,0))
            hrp.AssemblyLinearVelocity=Vector3.new(0,0,0)
        end)
    elseif mode=="tp_player_to_me" then
        takeCharOwnership(tpTargetPlayer.Character)
        pcall(function()
            tHrp.CFrame=CFrame.new(hrp.Position+Vector3.new(3,2,0))
            tHrp.AssemblyLinearVelocity=Vector3.new(0,0,0)
        end)
    end
end

-- ESP
local function createESP(player)
    if not HasDrawing then return end
    if espDrawings[player] then return end
    local circle=Drawing.new("Circle")
    circle.Thickness=2 circle.NumSides=48 circle.Filled=false circle.Transparency=0.9 circle.Visible=false
    local ring=Drawing.new("Circle")
    ring.Thickness=1 ring.NumSides=48 ring.Filled=false ring.Transparency=0.4 ring.Visible=false
    local nameT=Drawing.new("Text")
    nameT.Size=14 nameT.Center=true nameT.Outline=true nameT.OutlineColor=Color3.fromRGB(0,0,0) nameT.Visible=false
    local roleT=Drawing.new("Text")
    roleT.Size=12 roleT.Center=true roleT.Outline=true roleT.OutlineColor=Color3.fromRGB(0,0,0) roleT.Visible=false
    espDrawings[player]={Circle=circle,Ring=ring,Name=nameT,Role=roleT}
end

local function removeESP(player)
    local d=espDrawings[player]
    if not d then return end
    for _,dr in pairs(d) do pcall(function() dr:Remove() end) end
    espDrawings[player]=nil
end

local function updateESP()
    if not HasDrawing then return end
    for _,player in pairs(Players:GetPlayers()) do
        if player==LocalPlayer then continue end
        if not espDrawings[player] then createESP(player) end
        local d=espDrawings[player]
        if not d then continue end
        if not espEnabled then
            d.Circle.Visible=false d.Ring.Visible=false d.Name.Visible=false d.Role.Visible=false
            continue
        end
        local char=player.Character
        local head=char and char:FindFirstChild("Head")
        local hum=char and char:FindFirstChildOfClass("Humanoid")
        if not head or not hum or hum.Health<=0 then
            d.Circle.Visible=false d.Ring.Visible=false d.Name.Visible=false d.Role.Visible=false
            continue
        end
        local pos,onScreen=Camera:WorldToViewportPoint(head.Position)
        if not onScreen then
            d.Circle.Visible=false d.Ring.Visible=false d.Name.Visible=false d.Role.Visible=false
            continue
        end
        local roleText,color=getRole(player)
        local dist=(Camera.CFrame.Position-head.Position).Magnitude
        local scale=math.clamp(200/dist,20,60)
        d.Circle.Radius=scale
        d.Circle.Position=Vector2.new(pos.X,pos.Y)
        d.Circle.Color=color
        d.Circle.Visible=true
        d.Ring.Radius=scale+4
        d.Ring.Position=Vector2.new(pos.X,pos.Y)
        d.Ring.Color=color
        d.Ring.Visible=true
        d.Name.Text=player.Name
        d.Name.Position=Vector2.new(pos.X,pos.Y+scale+6)
        d.Name.Color=color
        d.Name.Visible=true
        d.Role.Text=roleText.." ["..math.floor(dist).."]"
        d.Role.Position=Vector2.new(pos.X,pos.Y+scale+22)
        d.Role.Color=color
        d.Role.Visible=true
    end
end

local function applyChams(player)
    if player==LocalPlayer or not chamsEnabled then return end
    local char=player.Character
    if not char then return end
    local hum=char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health<=0 then
        local old=char:FindFirstChild("Sota107_Chams")
        if old then old:Destroy() end
        return
    end
    local _,color=getRole(player)
    local hl=char:FindFirstChild("Sota107_Chams")
    if not hl then
        hl=Instance.new("Highlight")
        hl.Name="Sota107_Chams"
        hl.FillTransparency=0.55
        hl.OutlineTransparency=0
        hl.DepthMode=Enum.HighlightDepthMode.AlwaysOnTop
        hl.Parent=char
    end
    hl.FillColor=color
    hl.OutlineColor=color
end

local function clearAllChams()
    for _,p in pairs(Players:GetPlayers()) do
        local char=p.Character
        if char then
            local hl=char:FindFirstChild("Sota107_Chams")
            if hl then hl:Destroy() end
        end
    end
end

local function updateChams()
    for _,p in pairs(Players:GetPlayers()) do
        if p~=LocalPlayer then applyChams(p) end
    end
end

local function removeChams(player)
    local char=player.Character
    if char then
        local hl=char:FindFirstChild("Sota107_Chams")
        if hl then hl:Destroy() end
    end
end

local function hookPlayer(player)
    player.CharacterAdded:Connect(function()
        task.wait(0.5)
        if chamsEnabled then applyChams(player) end
        if hatEnabled then applyHat(player) end
        if stretchEnabled then applyStretch(player) end
    end)
end

for _,p in pairs(Players:GetPlayers()) do
    if p~=LocalPlayer then
        if HasDrawing then createESP(p) end
        hookPlayer(p)
    end
end

Players.PlayerAdded:Connect(function(p)
    if HasDrawing then createESP(p) end
    hookPlayer(p)
end)

Players.PlayerRemoving:Connect(function(p)
    removeESP(p)
    removeChams(p)
end)

RunService.RenderStepped:Connect(function()
    pcall(updateESP)
    pcall(updateChams)
    for _,p in pairs(Players:GetPlayers()) do
        if p~=LocalPlayer then
            pcall(applyHat,p)
            pcall(applyStretch,p)
        end
    end
end)

