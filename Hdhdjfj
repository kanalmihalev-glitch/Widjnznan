-- ============ РАСТЯГ (Aspect Ratio) ============
local function applyStretch(player)
    if player==LocalPlayer then return end
    local char=player.Character
    if not char then return end
    local hum=char:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    if hum.RigType~=Enum.HumanoidRigType.R15 then return end

    pcall(function()
        if stretchEnabled then
            if hum.BodyDepthScale then hum.BodyDepthScale.Value=STRETCH_AMOUNT end
            if hum.BodyHeightScale then hum.BodyHeightScale.Value=STRETCH_AMOUNT end
            if hum.BodyWidthScale then hum.BodyWidthScale.Value=STRETCH_AMOUNT end
            if hum.HeadScale then hum.HeadScale.Value=STRETCH_AMOUNT end
            if hum.BodyTypeScale then hum.BodyTypeScale.Value=STRETCH_AMOUNT/5 end
            if hum.ProportionScale then hum.ProportionScale.Value=0 end
        else
            if hum.BodyDepthScale then hum.BodyDepthScale.Value=1 end
            if hum.BodyHeightScale then hum.BodyHeightScale.Value=1 end
            if hum.BodyWidthScale then hum.BodyWidthScale.Value=1 end
            if hum.HeadScale then hum.HeadScale.Value=1 end
            if hum.BodyTypeScale then hum.BodyTypeScale.Value=0 end
            if hum.ProportionScale then hum.ProportionScale.Value=0 end
        end
    end)
end

