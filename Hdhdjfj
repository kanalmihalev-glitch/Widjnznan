local FONT_OPTIONS={"font_normal","font_minecraft","font_hand"}
local FONT_INDEX=1
local FONT_SIZE_OFFSET=0
local fontRegistry={}
local function regFontLbl(lbl,weight) fontRegistry[lbl]=weight or 2 end
local function applyFont()
    local key=FONT_OPTIONS[FONT_INDEX]
    for lbl,weight in pairs(fontRegistry) do
        pcall(function()
            if lbl and lbl.Parent then
                local sa=FONT_SIZE_OFFSET
                if key=="font_normal" then
                    if weight==3 then lbl.Font=Enum.Font.GothamBlack
                    elseif weight==2 then lbl.Font=Enum.Font.GothamBold
                    else lbl.Font=Enum.Font.Gotham end
                elseif key=="font_minecraft" then lbl.Font=Enum.Font.Arcade sa=sa-1
                elseif key=="font_hand" then lbl.Font=Enum.Font.Kalam sa=sa+2 end
                local bs=lbl:GetAttribute("BaseSize")
                if bs then lbl.TextSize=math.max(6,bs+sa) end
            end
        end)
    end
end

local function regLabel(lbl,key,weight)
    regFontLbl(lbl,weight or 2)
    lbl:SetAttribute("BaseSize",lbl.TextSize)
    table.insert(translateCallbacks,function()
        if lbl.Parent then lbl.Text=L[LANG][key] or key end
    end)
    lbl.Text=L[LANG][key] or key
end

