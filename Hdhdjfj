local function startFly()
    if flying then return end
    flying=true
    startNoclip()
    refreshHrp()
    if not hrp then flying=false return end
    if humanoid then pcall(function() humanoid.PlatformStand=true end) end
    pcall(function()
        hrp.AssemblyLinearVelocity=Vector3.new(0,0,0)
        hrp.AssemblyAngularVelocity=Vector3.new(0,0,0)
    end)
    if isMobile then setMobileFlyVisible(true) end
    if flyConn then flyConn:Disconnect() end
    flyConn=RunService.RenderStepped:Connect(function(dt)
        if not flying then return end
        local c=LocalPlayer.Character
        if not c then return end
        local root=c:FindFirstChild("HumanoidRootPart")
        if not root then return end
        local cam=workspace.CurrentCamera
        local moveDir=Vector3.new(0,0,0)
        pcall(function()
            if UserInputService:IsKeyDown(Enum.KeyCode.W) or mobileFlyDir.W then moveDir=moveDir+cam.CFrame.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) or mobileFlyDir.S then moveDir=moveDir-cam.CFrame.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) or mobileFlyDir.A then moveDir=moveDir-cam.CFrame.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) or mobileFlyDir.D then moveDir=moveDir+cam.CFrame.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.Space) or mobileFlyDir.Up then moveDir=moveDir+Vector3.new(0,1,0) end
            if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or mobileFlyDir.Down then moveDir=moveDir-Vector3.new(0,1,0) end
        end)
        pcall(function()
            root.AssemblyLinearVelocity=Vector3.new(0,0,0)
            if moveDir.Magnitude>0 then root.CFrame=root.CFrame+moveDir.Unit*TROLL_FLY_SPEED*dt end
        end)
    end)
end

local function stopFly()
    flying=false
    if flyConn then flyConn:Disconnect() flyConn=nil end
    if humanoid then pcall(function() humanoid.PlatformStand=false end) end
    for k in pairs(mobileFlyDir) do mobileFlyDir[k]=false end
    setMobileFlyVisible(false)
    if not (farming or tping or killing) then stopNoclip() end
end

