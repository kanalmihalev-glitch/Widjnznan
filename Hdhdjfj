local function doFling()
    local target=tpTargetPlayer
    if not target then return end
    local char=target.Character
    if not char then return end
    local targetHRP=char:FindFirstChild("HumanoidRootPart")
    if not targetHRP then return end

    -- Захват сети
    for _,part in pairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            pcall(function() part:SetNetworkOwner(LocalPlayer) end)
        end
    end
    task.wait(0.05)

    -- Убиваем массу
    for _,part in pairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            pcall(function()
                part.CustomPhysicalProperties=PhysicalProperties.new(0.01,0.3,0,1,1)
            end)
        end
    end

    -- Первичный подброс
    pcall(function()
        targetHRP.AssemblyLinearVelocity=Vector3.new(
            math.random(-3000,3000), 8000, math.random(-3000,3000))
        targetHRP.AssemblyAngularVelocity=Vector3.new(
            math.random(-500,500), math.random(-500,500), math.random(-500,500))
    end)

    -- Спам BodyVelocity + BodyAngularVelocity
    task.spawn(function()
        for i=1,60 do
            for _,part in pairs(char:GetDescendants()) do
                if part:IsA("BasePart") and part.Parent then
                    pcall(function()
                        local bv=Instance.new("BodyVelocity")
                        bv.MaxForce=Vector3.new(math.huge,math.huge,math.huge)
                        bv.Velocity=Vector3.new(
                            math.random(-8000,8000), math.random(5000,15000), math.random(-8000,8000))
                        bv.Parent=part
                        game:GetService("Debris"):AddItem(bv,0.3)
                    end)
                    pcall(function()
                        local bav=Instance.new("BodyAngularVelocity")
                        bav.MaxTorque=Vector3.new(math.huge,math.huge,math.huge)
                        bav.AngularVelocity=Vector3.new(
                            math.random(-50,50), math.random(-50,50), math.random(-50,50))
                        bav.Parent=part
                        game:GetService("Debris"):AddItem(bav,0.3)
                    end)
                end
            end
            task.wait(0.02)
        end
    end)

    -- Догоняющий ресет
    task.spawn(function()
        for i=1,40 do
            if targetHRP and targetHRP.Parent then
                pcall(function()
                    targetHRP.AssemblyLinearVelocity=Vector3.new(
                        math.random(-5000,5000), 10000, math.random(-5000,5000))
                end)
            end
            task.wait(0.05)
        end
    end)
end

local function applyInvisible()
    if not LocalPlayer.Character then return end
    savedTransparency={}
    for _,part in pairs(LocalPlayer.Character:GetDescendants()) do
        if part:IsA("BasePart") or part:IsA("Decal") then
            savedTransparency[part]=part.Transparency
            part.Transparency=1
        end
    end
    invisible=true
end

local function removeInvisible()
    for part,t in pairs(savedTransparency) do
        if part and part.Parent then pcall(function() part.Transparency=t end) end
    end
    savedTransparency={}
    invisible=false
end

local function isCoinValid(part)
    if not part or not part:IsA("BasePart") or not part.Parent or part.Transparency>=1 then return false end
    return part.Name:lower():find("coin")~=nil
end

local function refreshCoinCache()
    coinCache={}
    for _,obj in pairs(workspace:GetDescendants()) do
        if isCoinValid(obj) then table.insert(coinCache,obj) end
    end
    lastScan=tick()
end

local function findNearestCoin(vT)
    if tick()-lastScan>SCAN_INTERVAL then refreshCoinCache() end
    if not hrp then return nil end
    local myPos=hrp.Position
    local best=nil
    local bestDist=math.huge
    for i=#coinCache,1,-1 do
        local c=coinCache[i]
        if not isCoinValid(c) or (vT and vT[c]) then table.remove(coinCache,i)
        else
            local d=(c.Position-myPos).Magnitude
            if d<bestDist then bestDist=d best=c end
        end
    end
    return best
end

local function getCoinTarget(coin)
    return Vector3.new(coin.Position.X, coin.Position.Y-COIN_OFFSET, coin.Position.Z)
end

local function flyTo(targetPos,speed)
    if not hrp or not hrp.Parent then return false end
    speed=speed or FLY_SPEED
    local startPos=hrp.Position
    local dist=(targetPos-startPos).Magnitude
    if dist<0.5 then return true end
    local duration=math.max(dist/speed,0.05)
    local elapsed=0
    local done=false
    local conn
    conn=RunService.Heartbeat:Connect(function(dt)
        if not (farming or killing) or not hrp or not hrp.Parent then
            done=true
            if conn then conn:Disconnect() end
            return
        end
        elapsed=elapsed+dt
        local a=math.clamp(elapsed/duration,0,1)
        local s=a<0.5 and 2*a*a or 1-(-2*a+2)^2/2
        hrp.CFrame=CFrame.new(startPos:Lerp(targetPos,s))
        hrp.AssemblyLinearVelocity=Vector3.new(0,0,0)
        if a>=1 then done=true if conn then conn:Disconnect() end end
    end)
    while not done do
        if not (farming or killing) then break end
        task.wait(0.03)
    end
    return true
end

local function fireTouch(part)
    pcall(function()
        if firetouchinterest and hrp and part and part.Parent then
            firetouchinterest(hrp,part,0)
            task.wait()
            firetouchinterest(hrp,part,1)
        end
    end)
end

local function triggerBagFull()
    if hubPosition and hrp then
        pcall(function()
            hrp.CFrame=CFrame.new(hubPosition)
            hrp.AssemblyLinearVelocity=Vector3.new(0,0,0)
        end)
    end
end

local function farmLoop()
    collected=0
    visited={}
    collectedSinceReset=0
    refreshCoinCache()
    while farming do
        if not LocalPlayer.Character then task.wait(1) continue end
        refreshHrp()
        if not hrp then task.wait(0.3) continue end
        if not invisible then applyInvisible() end
        local coin=findNearestCoin(visited)
        if not coin then task.wait(0.3) continue end
        if not isCoinValid(coin) then refreshCoinCache() task.wait(0.1) continue end
        if flyTo(getCoinTarget(coin),FLY_SPEED) and isCoinValid(coin) then
            fireTouch(coin)
            task.wait(PAUSE_AT_COIN)
            if not isCoinValid(coin) then
                visited[coin]=true
                collected=collected+1
                collectedSinceReset=collectedSinceReset+1
                if collectedSinceReset>=BAG_LIMIT then
                    collectedSinceReset=0
                    visited={}
                    triggerBagFull()
                    task.wait(1)
                end
            end
        end
    end
end

local function startFarm()
    if farming then return end
    farming=true
    if not killing and not tping then startNoclip() end
    applyInvisible()
    task.spawn(farmLoop)
end

local function stopFarm()
    farming=false
    if not killing and not tping and not flying then stopNoclip() removeInvisible() end
end

local function tpFarmLoop()
    collectedTP=0
    visitedTP={}
    collectedTPSinceReset=0
    refreshCoinCache()
    while tping do
        if not LocalPlayer.Character then task.wait(1) continue end
        refreshHrp()
        if not hrp then task.wait(0.3) continue end
        if not invisible then applyInvisible() end
        if not hubPosition then hubPosition=hrp.Position end
        local coin=findNearestCoin(visitedTP)
        if not coin then task.wait(0.5) continue end
        if not isCoinValid(coin) then refreshCoinCache() task.wait(0.1) continue end
        hrp.CFrame=CFrame.new(getCoinTarget(coin))
        hrp.AssemblyLinearVelocity=Vector3.new(0,0,0)
        task.wait(0.05)
        if isCoinValid(coin) then
            fireTouch(coin)
            task.wait(TP_COIN_TIME)
            if not isCoinValid(coin) then
                visitedTP[coin]=true
                collectedTP=collectedTP+1
                collectedTPSinceReset=collectedTPSinceReset+1
                if collectedTPSinceReset>=BAG_LIMIT then
                    collectedTPSinceReset=0
                    visitedTP={}
                    triggerBagFull()
                    task.wait(1)
                end
            end
        end
        if hubPosition and tping then
            hrp.CFrame=CFrame.new(hubPosition)
            task.wait(TP_HUB_TIME)
        end
    end
end

local function startTp()
    if tping then return end
    tping=true
