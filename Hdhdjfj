local function animateCounter(label,from,to)
    local startTime=tick()
    task.spawn(function()
        while tick()-startTime<0.3 do
            local a=(tick()-startTime)/0.3
            label.Text=tostring(math.floor(from+(to-from)*a))
            task.wait(0.02)
        end
        label.Text=tostring(to)
    end)
end

local lastCollected=0
local lastKills=0
local lastPlayers=0

task.spawn(function()
    while true do
        task.wait(0.25)
        local tc=collected+collectedTP
        if tc~=lastCollected then
            animateCounter(coinStat,lastCollected,tc)
            lastCollected=tc
        end
        if kills~=lastKills then
            animateCounter(killStat,lastKills,kills)
            lastKills=kills
        end
        local pc=#Players:GetPlayers()
        if pc~=lastPlayers then
            animateCounter(playerStat,lastPlayers,pc)
            lastPlayers=pc
        end
    end
end)

